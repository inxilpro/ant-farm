#!/bin/sh
# A stand-in for `ansible-inventory --list --output FILE`, matching the fixture's hosts file.
output=/dev/stdout
while [ $# -gt 0 ]; do
  [ "$1" = "--output" ] && output="$2"
  shift
done
cat > "$output" <<'JSON'
{
  "_meta": { "hostvars": {} },
  "all": { "children": ["ungrouped", "web", "db"] },
  "web": { "hosts": ["web1", "web2"] },
  "db": { "hosts": ["db1"] }
}
JSON
